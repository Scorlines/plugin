## 3. Querying — Avoid N+1 and Over-fetching

```typescript
// ❌ N+1 Problem: 1 query for users + N queries for their posts
const users = await prisma.user.findMany();
for (const user of users) {
  const posts = await prisma.post.findMany({ where: { authorId: user.id } });
  user.posts = posts; // N extra queries!
}

// ✅ Eager loading: Single query with include
const users = await prisma.user.findMany({
  include: {
    posts: {
      where: { status: 'PUBLISHED' },
      orderBy: { createdAt: 'desc' },
      take: 5,
    },
  },
});

// ✅ Select only needed fields — never leak passwords or tokens
const users = await prisma.user.findMany({
  select: {
    id: true,
    name: true,
    email: true,
    role: true,
    // password: NEVER included
    // refreshToken: NEVER included
    _count: { select: { posts: true } }, // Count without loading all posts
  },
});
```

### Pagination — Cursor-Based (Recommended)

```typescript
// ✅ Cursor-based pagination — efficient for large datasets
async function getPaginatedPosts(cursor?: string, limit = 20) {
  const posts = await prisma.post.findMany({
    take: limit + 1,                           // Fetch one extra to check if more exist
    ...(cursor && {
      cursor: { id: cursor },
      skip: 1,                                 // Skip the cursor itself
    }),
    where: { status: 'PUBLISHED' },
    orderBy: { createdAt: 'desc' },
    select: { id: true, title: true, slug: true, excerpt: true, createdAt: true },
  });

  const hasMore = posts.length > limit;
  const data = hasMore ? posts.slice(0, limit) : posts;
  const nextCursor = hasMore ? data[data.length - 1]?.id : null;

  return { data, nextCursor, hasMore };
}
```

### Pagination — Offset-Based (Simple Use Cases)

```typescript
// ✅ Offset-based pagination — simpler, for admin panels
async function getUsersPage(page = 1, pageSize = 20) {
  const [data, totalItems] = await prisma.$transaction([
    prisma.user.findMany({
      skip: (page - 1) * pageSize,
      take: pageSize,
      orderBy: { createdAt: 'desc' },
      select: { id: true, name: true, email: true, role: true, createdAt: true },
    }),
    prisma.user.count(),
  ]);

  return {
    data,
    pagination: {
      page,
      pageSize,
      totalItems,
      totalPages: Math.ceil(totalItems / pageSize),
      hasNextPage: page * pageSize < totalItems,
      hasPrevPage: page > 1,
    },
  };
}
```

