## 9. Caching Layer (Redis)

```typescript
// ✅ Redis cache wrapper
import { Redis } from 'ioredis';

const redis = new Redis(process.env.REDIS_URL!);

// Generic cache-aside pattern
async function cached<T>(
  key: string,
  ttlSeconds: number,
  fetcher: () => Promise<T>,
): Promise<T> {
  const cached = await redis.get(key);
  if (cached) return JSON.parse(cached) as T;

  const data = await fetcher();
  await redis.set(key, JSON.stringify(data), 'EX', ttlSeconds);
  return data;
}

// Usage
const popularPosts = await cached('popular_posts', 300, () =>
  prisma.post.findMany({
    where: { status: 'PUBLISHED' },
    orderBy: { viewCount: 'desc' },
    take: 10,
  }),
);

// Invalidate on mutation
async function updatePost(id: string, data: UpdatePostInput) {
  await prisma.post.update({ where: { id }, data });
  await redis.del('popular_posts');            // Invalidate specific cache
  await redis.del(`post:${id}`);               // Invalidate entity cache
}
```

