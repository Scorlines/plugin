## 2. Custom Metrics

```typescript
// ✅ Track business and performance metrics
import { metrics } from '@opentelemetry/api';

const meter = metrics.getMeter('my-app');

// Counter: Track total events
const requestCounter = meter.createCounter('http_requests_total', {
  description: 'Total HTTP requests',
});

// Histogram: Track response time distribution
const responseTime = meter.createHistogram('http_response_time_ms', {
  description: 'HTTP response time in milliseconds',
  unit: 'ms',
});

// Gauge: Track current state
const activeConnections = meter.createUpDownCounter('db_active_connections', {
  description: 'Active database connections',
});

// Business metrics
const signupCounter = meter.createCounter('user_signups_total', {
  description: 'Total user signups',
});
const orderValueHistogram = meter.createHistogram('order_value_usd', {
  description: 'Order values in USD',
});

// Usage in middleware/handlers
function trackRequest(req: Request, res: Response, durationMs: number) {
  const attributes = {
    method: req.method,
    path: req.url,
    status: res.status.toString(),
  };

  requestCounter.add(1, attributes);
  responseTime.record(durationMs, attributes);
}

// Usage in business logic
async function createUser(data: CreateUserInput) {
  const user = await db.user.create({ data });
  signupCounter.add(1, { source: data.source, plan: data.plan });
  return user;
}
```

### Key Metrics to Track

| Category | Metric | Type | Alert Threshold |
|----------|--------|------|----------------|
| **HTTP** | Request rate (req/sec) | Counter | Sudden drop > 50% |
| **HTTP** | Response time (p50, p95, p99) | Histogram | p95 > 500ms, p99 > 2s |
| **HTTP** | Error rate (4xx, 5xx) | Counter | 5xx rate > 1% |
| **DB** | Query time | Histogram | p95 > 200ms |
| **DB** | Active connections | Gauge | > 80% of pool size |
| **DB** | Slow queries | Counter | > 5/min |
| **Cache** | Hit rate | Counter | < 80% |
| **Cache** | Connection errors | Counter | Any |
| **Auth** | Login failures | Counter | > 10/min from same IP |
| **Auth** | Token refresh failures | Counter | Sudden spike |
| **Business** | Signups | Counter | Sudden drop |
| **Business** | Orders / transactions | Counter | Sudden drop |
| **System** | Memory usage | Gauge | > 85% |
| **System** | CPU usage | Gauge | > 80% sustained |
| **System** | Disk usage | Gauge | > 90% |

