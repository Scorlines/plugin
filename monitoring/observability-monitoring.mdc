## 3. Health Check Endpoints

```typescript
// ✅ Three-tier health check system
// app/api/health/route.ts — Basic liveness
export async function GET() {
  return Response.json({ status: 'ok', timestamp: new Date().toISOString() });
}

// app/api/health/ready/route.ts — Readiness (dependencies check)
export async function GET() {
  const checks: Record<string, { status: string; latency?: number; error?: string }> = {};
  let overallStatus = 'healthy';

  // Database check
  try {
    const start = Date.now();
    await prisma.$queryRaw`SELECT 1`;
    checks.database = { status: 'healthy', latency: Date.now() - start };
  } catch (err) {
    checks.database = { status: 'unhealthy', error: 'Connection failed' };
    overallStatus = 'unhealthy';
  }

  // Redis check
  try {
    const start = Date.now();
    await redis.ping();
    checks.redis = { status: 'healthy', latency: Date.now() - start };
  } catch (err) {
    checks.redis = { status: 'unhealthy', error: 'Connection failed' };
    overallStatus = 'degraded';
  }

  // External API check
  try {
    const start = Date.now();
    const res = await fetch('https://api.stripe.com/v1/', {
      method: 'HEAD',
      signal: AbortSignal.timeout(3000),
    });
    checks.stripe = { status: res.ok ? 'healthy' : 'degraded', latency: Date.now() - start };
  } catch {
    checks.stripe = { status: 'degraded', error: 'Timeout or unreachable' };
    if (overallStatus === 'healthy') overallStatus = 'degraded';
  }

  return Response.json(
    {
      status: overallStatus,
      version: process.env.APP_VERSION || 'unknown',
      uptime: Math.floor(process.uptime()),
      timestamp: new Date().toISOString(),
      checks,
    },
    { status: overallStatus === 'unhealthy' ? 503 : 200 },
  );
}

// app/api/health/startup/route.ts — Startup probe (one-time checks)
export async function GET() {
  try {
    // Verify critical env vars exist
    const required = ['DATABASE_URL', 'JWT_ACCESS_SECRET', 'JWT_REFRESH_SECRET'];
    const missing = required.filter((key) => !process.env[key]);
    if (missing.length > 0) {
      return Response.json(
        { status: 'failed', missing },
        { status: 503 },
      );
    }

    // Verify database is migrated
    await prisma.$queryRaw`SELECT 1`;

    return Response.json({ status: 'ready' });
  } catch (err) {
    return Response.json({ status: 'failed', error: 'Startup check failed' }, { status: 503 });
  }
}
```

### Docker / Kubernetes Health Integration

```yaml
# docker-compose.yml
services:
  app:
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:3000/api/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s
```

```yaml
# kubernetes deployment.yml
livenessProbe:
  httpGet:
    path: /api/health
    port: 3000
  initialDelaySeconds: 10
  periodSeconds: 30
readinessProbe:
  httpGet:
    path: /api/health/ready
    port: 3000
  initialDelaySeconds: 5
  periodSeconds: 10
startupProbe:
  httpGet:
    path: /api/health/startup
    port: 3000
  failureThreshold: 30
  periodSeconds: 5
```

