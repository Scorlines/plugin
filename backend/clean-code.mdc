## 6. Encapsulation — Hide Complexity

```typescript
// ❌ Business rules scattered in component
function OrderSummary({ order }: { order: Order }) {
  const subtotal = order.items.reduce((sum, item) => sum + item.price * item.qty, 0);
  const tax = subtotal * 0.11;
  const shipping = subtotal > 100 ? 0 : 9.99;
  const discount = order.coupon ? subtotal * order.coupon.rate : 0;
  const total = subtotal + tax + shipping - discount;

  return <div>Total: {total}</div>;
}

// ✅ Business logic encapsulated in a pure utility
// lib/pricing.ts
export function calculateOrderTotals(order: Order): OrderTotals {
  const subtotal = order.items.reduce((sum, item) => sum + item.price * item.qty, 0);
  const tax = subtotal * TAX_RATE;
  const shipping = subtotal > FREE_SHIPPING_THRESHOLD ? 0 : SHIPPING_COST;
  const discount = order.coupon ? subtotal * order.coupon.rate : 0;
  return { subtotal, tax, shipping, discount, total: subtotal + tax + shipping - discount };
}

// Component is now clean
function OrderSummary({ order }: { order: Order }) {
  const totals = calculateOrderTotals(order);
  return <div>Total: {formatCurrency(totals.total)}</div>;
}
```

