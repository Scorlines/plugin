## 3. Single Responsibility (SRP)

```typescript
// ❌ Function doing too many things
async function handleUserRegistration(data: FormData) {
  const email = data.get('email') as string;
  const password = data.get('password') as string;

  // Validation (responsibility 1)
  if (!email.includes('@')) throw new Error('Invalid email');
  if (password.length < 8) throw new Error('Password too short');

  // Hashing (responsibility 2)
  const hashedPassword = await bcrypt.hash(password, 12);

  // Database insert (responsibility 3)
  const user = await db.user.create({ data: { email, password: hashedPassword } });

  // Email sending (responsibility 4)
  await sendEmail(email, 'Welcome!', welcomeTemplate(user.name));

  // Analytics (responsibility 5)
  analytics.track('user_registered', { userId: user.id });

  return user;
}

// ✅ Each function has ONE responsibility
async function handleUserRegistration(data: RegistrationInput) {
  const validated = validateRegistration(data);
  const user = await createUser(validated);
  await onUserCreated(user); // Side effects: email, analytics
  return user;
}

function validateRegistration(data: RegistrationInput): ValidatedRegistration {
  return RegistrationSchema.parse(data); // Zod handles validation
}

async function createUser(data: ValidatedRegistration): Promise<User> {
  const hashedPassword = await hashPassword(data.password);
  return db.user.create({ data: { email: data.email, password: hashedPassword } });
}

async function onUserCreated(user: User): Promise<void> {
  await Promise.allSettled([
    emailService.sendWelcome(user.email),
    analytics.track('user_registered', { userId: user.id }),
  ]);
}
```

**SRP Rules:**
- Each function does exactly ONE thing. If you need "and" to describe it, split it.
- Functions should be under 30 lines. Over 50 lines is a code smell.
- Extract helper functions with clear names instead of writing comments.

