## 4. DRY (Don't Repeat Yourself)

```typescript
// ❌ Repeated logic across API handlers
export async function GET(req: Request) {
  const token = req.headers.get('authorization')?.replace('Bearer ', '');
  if (!token) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
  const user = verifyToken(token);
  if (!user) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 });
  // ... handler logic
}

// ✅ Extracted into reusable utility
import { withAuth } from '@/lib/api-middleware';

export const GET = withAuth(async (req, user) => {
  // user is already verified — focus on business logic only
  const posts = await getPostsByUser(user.id);
  return NextResponse.json({ data: posts });
});
```

**DRY Rules:**
- If you copy-paste code 3+ times, extract it.
- Share logic through composition (higher-order functions, middleware), not inheritance.
- Keep validation schemas (`Zod`, `Pydantic`) as single source of truth — don't duplicate rules.

