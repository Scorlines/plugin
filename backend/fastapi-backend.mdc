## 3. Configuration (pydantic-settings)

```python
# ✅ config.py — Validate env vars at startup
from pydantic_settings import BaseSettings
from pydantic import Field

class Settings(BaseSettings):
    APP_NAME: str = "MyApp"
    APP_VERSION: str = "1.0.0"
    DEBUG: bool = False
    ENVIRONMENT: str = "production"

    # Database
    DATABASE_URL: str
    DATABASE_POOL_SIZE: int = Field(default=20, ge=5, le=100)

    # Auth
    JWT_ACCESS_SECRET: str = Field(min_length=32)
    JWT_REFRESH_SECRET: str = Field(min_length=32)
    ACCESS_TOKEN_EXPIRE_MINUTES: int = 15
    REFRESH_TOKEN_EXPIRE_DAYS: int = 7

    # CORS
    ALLOWED_ORIGINS: list[str] = ["http://localhost:3000"]

    # Redis (optional)
    REDIS_URL: str | None = None

    model_config = {"env_file": ".env", "env_file_encoding": "utf-8"}

settings = Settings()  # Fails fast if required vars are missing
```

