from starlette.middleware.cors import CORSMiddleware

app.add_middleware(TrustedHostMiddleware, allowed_hosts=["yourapp.com", "*.yourapp.com"])
```

## CORS Configuration

```typescript
// ⚠️ Access-Control-Allow-Origin does NOT support multiple comma-separated origins!
// You MUST validate the request Origin header dynamically per-request.

// ✅ CORRECT: Dynamic origin validation in middleware
// middleware.ts
const ALLOWED_ORIGINS = new Set([
  'https://yourapp.com',
  'https://admin.yourapp.com',
  'https://staging.yourapp.com',
]);

export function middleware(request: NextRequest) {
  const origin = request.headers.get('origin');
  const response = NextResponse.next();

  if (origin && ALLOWED_ORIGINS.has(origin)) {
    response.headers.set('Access-Control-Allow-Origin', origin);
    response.headers.set('Access-Control-Allow-Methods', 'GET, POST, PUT, PATCH, DELETE, OPTIONS');
    response.headers.set('Access-Control-Allow-Headers', 'Content-Type, Authorization');
    response.headers.set('Access-Control-Allow-Credentials', 'true');
    response.headers.set('Access-Control-Max-Age', '86400');
  }

  // Handle preflight
  if (request.method === 'OPTIONS') {
    return new NextResponse(null, { status: 204, headers: response.headers });
  }

  return response;
}
```

```python
# FastAPI
app.add_middleware(
    CORSMiddleware,
    allow_origins=["https://yourapp.com"],  # Never ["*"] in production
    allow_credentials=True,
    allow_methods=["GET", "POST", "PUT", "DELETE"],
    allow_headers=["Authorization", "Content-Type"],
)
```

## Secret Management

- **NEVER** hardcode secrets, API keys, database URLs, or tokens in source code.
- Use `.env.local` for development, cloud secret managers for production (Vault, AWS Secrets Manager, Vercel Environment Variables).
- **NEVER** commit `.env` files. Always have `.env` in `.gitignore`.
- Rotate secrets on a schedule. Implement immediate rotation procedures for compromised secrets.
- Use separate secrets per environment (dev/staging/prod).

```bash
# .env.example — Commit this as documentation, never with real values
DATABASE_URL=postgresql://user:password@localhost:5432/mydb
JWT_SECRET=generate-a-strong-random-string-here
NEXT_PUBLIC_API_URL=http://localhost:3000/api
```

## Rate Limiting

```typescript
// ✅ Rate limit all public endpoints
import rateLimit from 'express-rate-limit';

const apiLimiter = rateLimit({
  windowMs: 15 * 60 * 1000, // 15 minutes
  max: 100, // limit each IP to 100 requests per window
  standardHeaders: true,
  legacyHeaders: false,
  message: { error: 'Too many requests, please try again later.' },
});

// Stricter limits for auth endpoints
const authLimiter = rateLimit({
  windowMs: 15 * 60 * 1000,
  max: 5, // 5 login attempts per 15 minutes
});
```

```python
# FastAPI with slowapi
from slowapi import Limiter
from slowapi.util import get_remote_address

limiter = Limiter(key_func=get_remote_address)

@app.post("/api/login")
@limiter.limit("5/15minutes")
async def login(request: Request, credentials: LoginSchema):
    ...
```

## Dependency Security

- Run `npm audit --production` or `pip audit` in every CI pipeline.
- Block merges with critical/high severity vulnerabilities.
- Pin dependency versions in production. Use lockfiles (`package-lock.json`, `poetry.lock`).
- Review new dependencies before adding: check maintenance status, download counts, known issues.
- Prefer well-maintained packages with active security teams.

## Never Trust, Always Verify

- Never trust client-side validation alone — always re-validate server-side.
- Never trust JWT payload without signature verification.
- Never trust file extensions — verify MIME types.
- Never trust URL parameters for authorization decisions.
- Never trust `req.headers['x-forwarded-for']` without a trusted proxy configuration.
